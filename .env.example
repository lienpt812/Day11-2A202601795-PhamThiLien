# Copy file nay thanh .env roi dien gia tri that.
# Khong commit file .env len GitHub.

# API key Gemini chinh - lay tai https://aistudio.google.com/apikey
# Neu GOOGLE_API_KEYS duoc khai bao, app co the dung danh sach key ben duoi de xoay vong.
GOOGLE_API_KEY=your-primary-google-ai-studio-key-here

# Nhieu API key de lam co che rotate khi gap rate limit.
# Cach ghi: phan tach bang dau phay, khong co dau ngoac.
# Vi du:
# GOOGLE_API_KEYS=key-1,key-2,key-3
GOOGLE_API_KEYS=

# Bat/tat co che rotate key trong code tu viet.
# 1 = bat, 0 = tat
GOOGLE_API_KEY_ROTATION_ENABLED=1

# So lan thu lai toi da khi gap rate limit/transient error.
GOOGLE_API_MAX_RETRIES=3

# Thoi gian cho giua cac lan retry, don vi giay.
GOOGLE_API_RETRY_DELAY_SECONDS=2

# Giu = 0 neu dung Google AI Studio, khong dung Vertex AI.
GOOGLE_GENAI_USE_VERTEXAI=0

# NeMo Guardrails voi Gemini can LangChain framework.
NEMOGUARDRAILS_LLM_FRAMEWORK=langchain
